{
	"extends": "@tsconfig/node22/tsconfig.json",
	"compilerOptions": {
		"types": ["vitest/globals", "node"],
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"declaration": true,
		"skipLibCheck": true
	},
	"include": ["src", "tests", "*.ts"]
}
